export default "import \"@openzeppelin/contracts/token/ERC20/IERC20.sol\";\n\ncontract Spender {\n    IERC20 public erc20;\n    constructor(IERC20 _erc20) {\n        erc20 = _erc20;\n    }\n    function send (address from, address to, uint _amount) public {\n        erc20.transferFrom(from, to, _amount);\n    }\n}";